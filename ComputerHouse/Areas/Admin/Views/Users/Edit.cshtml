@model ComputerHouse.Models.ApplicationUser
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="light-background-with-border">
        <div class="row">
            <div class="col-12 text-center">
                <h4 class="text-primary"><strong>Edit User</strong></h4>
            </div>
            <div class="col-12 col-md-8">
                <form method="post" asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input asp-for="Id" type="hidden" />
                    <input asp-for="FirstName" type="hidden" />
                    <div class="form-group row">
                        <div class="col-4 text-right">
                            <label asp-for="FirstName" class="custom-label"></label>
                        </div>
                        <div class="col-8">
                            <input asp-for="FirstName" class="form-control" disabled />
                        </div>
                    </div>
                    <input asp-for="LastName" type="hidden" />
                    <div class="form-group row">
                        <div class="col-4 text-right">
                            <label asp-for="LastName" class="custom-label"></label>
                        </div>
                        <div class="col-8">
                            <input asp-for="LastName" class="form-control" disabled />
                        </div>
                    </div>
                    <input asp-for="Email" type="hidden" />
                    <div class="form-group row">
                        <div class="col-4 text-right">
                            <label asp-for="Email" class="custom-label"></label>
                        </div>
                        <div class="col-8">
                            <input asp-for="Email" class="form-control" disabled />
                        </div>
                    </div>
                    <input asp-for="PhoneNumber" type="hidden" />
                    <div class="form-group row">
                        <div class="col-4 text-right">
                            <label asp-for="PhoneNumber" class="custom-label"></label>
                        </div>
                        <div class="col-8">
                            <input asp-for="PhoneNumber " class="form-control" disabled />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-4 text-right">
                            <label asp-for="LockoutEnd" class="custom-label"></label>
                        </div>
                        <div class="col-8">
                            <input asp-for="LockoutEnd" id="lockoutEnd" type="datetime" class="form-control" />
                            <span asp-validation-for="LockoutEnd" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-4 text-right">
                            <label asp-for="LockoutReason" class="custom-label"></label>
                        </div>
                        <div class="col-8">
                            <textarea asp-for="LockoutReason" rows="2" class="form-control"></textarea>
                            <span asp-validation-for="LockoutReason" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-4 text-right">
                            <label asp-for="AccessFailedCount" class="custom-label"></label>
                        </div>
                        <div class="col-8">
                            <input asp-for="AccessFailedCount" class="form-control" />
                            <span asp-validation-for="AccessFailedCount" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-6">
                            <input type="submit" value="Update" asp-route-id="@Model.Id" class="btn btn-warning form-control" />
                        </div>
                        <div class="col-6">
                            <a asp-action="Index" class="btn btn-success form-control">To Users</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script type="text/javascript">

        $(document).ready(function() {
            $("#lockoutEnd").datepicker({
                dateFormat: 'dd/mm/yy'
                //Setting previous date means user is not locked.
            });
        });

        $("#lockoutEnd").val($.datepicker.formatDate('DD dd M, yy', new Date($("#lockoutEnd").val()))); //For displaying in textbox
        $('#lockoutEnd').datetimepicker();

    </script>
}


@*Useful:
    @if (Model.HasValue)
    {
        // This'll get you a fairly American date format
        @Convert.ToDateTime(Model).ToString("MM/dd/yyyy}")
    }*@
