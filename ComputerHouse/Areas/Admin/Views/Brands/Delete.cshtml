@model ComputerHouse.Models.Brand
@{
    ViewData["Title"] = "Delete";
}

<div class="container">
    <div class="light-background-with-border">
        <h4 class="text-danger"><strong>Delete Brand</strong></h4>
        <hr />
        <br />
        <fieldset disabled>
            <div class="form-group row">
                @*<div class="col-4 offset-md-1 col-md-2 text-right">
                <label asp-for="Name"></label>
                </div>*@
                <div class="col col-md-6">
                    <label asp-for="Name" class="custom-label"></label>
                    <input asp-for="Name" class="form-control" />
                </div>
            </div>
        </fieldset>
        <form asp-action="Delete" method="post">
            <div asp-validation-summary="ModelOnly"></div>
            <input type="hidden" asp-for="Id" />
            <div class="row">
                <div class="col-6 col-md-3">
                    @*<a class="btn btn-lg btn-danger form-control" asp-action="Delete" asp-route-id="@Model.Id">Delete Brand</a>*@
                    <!--The above code does not work becomes ambigious due to two Delete method so we using form-->
                    <input type="submit" class="btn btn-lg btn-danger form-control" value="Delete" />
                </div>

                <div class="col-6 col-md-3">
                    <a class="btn btn-lg btn-secondary form-control" asp-action="Index">Cancel Delete</a>
                </div>
            </div>
        </form>
    </div>
</div>

<!--Everytime when you are submitting the form to protect from unnecessary scripts.-->
@section Scripts{
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");}
}