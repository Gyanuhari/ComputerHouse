@model IEnumerable<ComputerHouse.Models.Brand>

@{
    ViewData["Title"] = "Index";
}

<div class="container">
    <div class="light-background-with-border">
        <div class="row mb-3">
            <div class="col-6">
                <h4 class="text-primary"><strong>List of Brands</strong></h4>
            </div>
            <div class="col-6 text-right">
                @*<a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i>&nbsp;Create New</a>*@
                <!--Better show this in next subcategory create so students will understand more-->
                @await Html.PartialAsync("_CreateNewPartial")
            </div>
        </div>
        <table class="table table-striped table-hover table-bordered" id="brandTable">
            <thead class="table-primary">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
                    @*<td>@Html.DisplayNameFor(m => m.DisplayOrder)</td>*@
                    @*<td>@Html.DisplayNameFor(m=>m.CreatedBy)</td>*@
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
                        <td>
                            @*<a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Id"><i class="far fa-edit"></i>&nbsp;Edit</a>
                                <a class="btn btn-success" asp-action="Details" asp-route-id="@item.Id"><i class="far fa-list-alt"></i>&nbsp;Details</a>
                                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id"><i class="far fa-edit"></i>&nbsp;Delete</a>*@
                            <!--Better show this in next subcategory create so students will understand more-->
                            @await Html.PartialAsync("_TableButtonPartial", item.Id)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts{
    @*<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.1.0/jquery.min.js"></script>*@
    @*These scripts should be used before any javaScripts code*@
    @*<script type="text/javascript" src="https://cdn.datatables.net/1.10.16/js/jquery.dataTables.min.js"></script>*@
    <script>
        $(document).ready(function () {
            $("#brandTable").DataTable();
        });
    </script>
}


