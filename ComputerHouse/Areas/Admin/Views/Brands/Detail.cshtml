@model ComputerHouse.Models.Brand
@{
    ViewData["Title"] = "Detail";
}

<div class="container">
    <div class="light-background-with-border">
            <h4><strong>Details of Brand</strong></h4>
            <hr />
            <br />
            <fieldset disabled>
                <div class="form-group row">
                    @*<div class="col-4 offset-md-1 col-md-2 text-right">
                    <label asp-for="Name"></label>
                    </div>*@
                    <div class="col col-md-6">
                        <label asp-for="Name" class="custom-label"></label>
                        <input asp-for="Name" class="form-control" />
                    </div>
                </div>
            </fieldset>
            <div class="row">
                <div class="col-6 col-md-3">
                    <a class="btn btn-lg btn-primary form-control" asp-action="Edit" asp-route-id="@Model.Id">Edit Brand</a>
                </div>
                <div class="col-6 col-md-3">
                    <a class="btn btn-lg btn-success form-control" asp-action="Index">To Brand List</a>
                </div>
            </div>
    </div>
</div>

