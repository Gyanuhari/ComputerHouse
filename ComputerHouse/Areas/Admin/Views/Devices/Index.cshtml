@model IEnumerable<ComputerHouse.Models.Device>
@{
    ViewData["Title"] = "Index";
}

<div class="container">
    <div class="light-background-with-border">
        <div class="row mb-3">
            <div class="col">
                <h4 class="text-primary"><strong>List of Devices</strong></h4>
            </div>
            <div class="col text-right">
                @await Html.PartialAsync("_CreateNewPartial")
            </div>
        </div>
        <table class="table table-hover table-striped table-bordered" id="tblDevice">
            <thead class="table-primary">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.BrandCategory.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Brand.Name)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.BrandCategory.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Brand.Name)</td>
                        <td>
                            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Id"><i class="far fa-edit"></i>&nbsp;Edit</a>
                            <a class="btn btn-success" asp-action="Detail" asp-route-id="@item.Id"><i class="far fa-list-alt"></i>&nbsp;Details</a>
                            <a class="btn btn-danger" onclick="deleteConfirm('@item.Id')"><i class="far fa-trash-alt"></i>&nbsp;Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts{

<script type="text/javascript">
    $(document).ready(function () {
        $("#tblDevice").DataTable();
    });

    function deleteConfirm(deviceId) {
        //console.log('Ok');
        swal({
            title: "Are you sure?",
            text: "Once deleted, you will not be able to recover the data!",
            icon: "warning",
            buttons: true,
            dangerMode: true,
        })
            .then((willDelete) => {
                if (willDelete) {
                    
                    $.post("/admin/devices/delete", { id: deviceId }, function (data, status) {     
                        if (status === "success") {

                            //refreshes the window
                            //window.location.reload();
                            swal("Data has been deleted successfully!", {
                                icon: "error",
                            });
                        }
                        else {
                            swal("Error in deleting data!", {
                                icon: "error",
                            });
                        }
                    });
                } else {
                    swal("Your data is safe!!");
                }
            });
    }

    //source: https://sweetalert.js.org/guides/
    //source: https://www.w3schools.com/jquery/jquery_ajax_get_post.asp
</script>
}

