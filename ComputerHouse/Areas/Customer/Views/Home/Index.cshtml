<!--Implementation of Email Subscription-->
<div class="container-email-subscribe">
    <div class="container">
        <form method="post" asp-action="EmailSubscription" asp-controller="Home">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="col-8 offset-md-2 col-md-6 text-right">
                    <input asp-for="@Model.EmailSubscription.Email" class="form-control" type="email" placeholder="Please Enter Email" />
                    <span asp-validation-for="@Model.EmailSubscription.Email" class="text-danger"></span>
                </div>
                <!--p-0 is used so that we will have pleanty room for button in extra small device-->
                <div class="col-4 col-md-4 p-0">
                    <button type="submit" class="btn btn-lg btn-primary">Subscribe</button>
                </div>
            </div>
        </form>
    </div>
</div>
