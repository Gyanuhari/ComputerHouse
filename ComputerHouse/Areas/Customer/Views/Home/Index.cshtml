<!--Modal Popup For Quick View-->
<div class="modal fade bd-example-modal-lg" role="dialog" id="quick-view-modal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-body">
                @*Start*@
                <div class="light-background-with-border">
                    <div class="row">
                        <div class="col-12 col-md-5">
                            @*@{
                                    var base64 = Convert.ToBase64String(Model.Image);
                                    var imgSrc = string.Format("data:image/jpg;base64,{0}", base64);
                                }*@
                            <img id="img-device" src="" class="img-fluid" />
                        </div>
                        <div class="col-12 col-md-7">
                            <h3 id="modal-device-name"></h3>
                            <hr />
                            <h3 id="modal-device-price"></h3>
                            <hr />
                            <a href="#" id="features">See all features</a>
                            <br />
                            <hr />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <p id="modal-device-description"></p>
                            <hr />
                            <div class="row">
                                <div class="col-6 offset-6 text-right">
                                    <a class="btn btn-lg btn-light form-control" data-dismiss="modal"><b>CLOSE</b></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                @*End*@
            </div>
        </div>
    </div>
</div>
<!--End Of Modal Popup For Quick View-->

@section Scripts{
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");}

    <script type="text/javascript">

        function quickView(deviceId) {

            //Clearing previous values appended values
            $("#modal-device-name").empty();
            $("#modal-device-description").empty();


            //console.log(deviceId);

            $.getJSON('/api/device/' + deviceId, function (data, status) {
                //console.log(data);
                if (status === "success") {

                    $("#quick-view-modal").modal({ backdrop: 'static', keyboard: false });
                    $("#modal-device-name").append(data.name);
                    $("#modal-device-description").append(data.description);

                    const formatter = new Intl.NumberFormat('en-US', {
                        style: 'currency',
                        currency: 'AUD',
                        minimumFractionDigits: 2
                    });
                    var price = formatter.format(data.price) // "$1,000.00"
                    $("#modal-device-price").text(price);

                    $("#features").attr("href", "/Customer/Shoppings/Detail/" + deviceId);
                    $('#img-device').attr('src', 'data:image/jpg;base64,' + data.image);
                }
                else {
                    toastr.error("Error: Something went wrong.");
                    console.log("Something went wrong!");
                }
            });
        }
    </script>
}