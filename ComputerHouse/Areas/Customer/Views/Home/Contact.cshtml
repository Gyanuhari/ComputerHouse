@model ComputerHouse.Models.CustomerContactUs
@{
    ViewData["Title"] = "Contact";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="location" class="map-contact">

</div>

@*For using embeded maps*@
@*<iframe height="450" width="100%" frameborder="0" style="border:0"
    src="https://www.google.com/maps/embed/v1/view?key=AIzaSyDu45jwk_bHwMNjJGUpcTuzG1mZMUP47wA&center=-33.963,151.099&zoom=18&maptype=satellite" allowfullscreen>
    </iframe>*@
<br />
<br />
<div class="container">
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row">
            <div class="col-lg-7 mb-3">
                <div class="row">
                    <div class="col-12 pb-2">
                        <h2><b>Contact Us</b></h2>
                    </div>
                    <br />
                </div>
                <div class="row">
                    @*In small device we want each inbox to be as a group so that there will be space between upper and lower input element*@
                    <div class="col-lg-6 form-group">
                        <input asp-for="FullName" class="form-control" placeholder="Your Name" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="col-lg-6 form-group">
                        <input asp-for="Email" class="form-control" placeholder="Your Email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 form-group">
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Mobile Number Eg. 0450956465" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="col-lg-6 form-group">
                        <input asp-for="Location" class="form-control" placeholder="Your Location" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-lg-12">
                        <textarea asp-for="Message" rows="6" class="form-control" placeholder="Your Message"></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-6">
                        <button type="submit" class="btn btn-lg btn-primary form-control">Submit Message</button>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 offset-lg-1 ml-lg-5 contact-address">
                <h4>Computer House</h4>
                <address>
                    Suite 101, Level 4, <br />
                    67-69 Dora Street, Hurstville <br />
                    NSW 2220, Australia <br />
                    Phone: +61-0450956465 <br />
                </address>
                <br />
                <h5>Order Related Enquiry:</h5>
                <address>
                    orderitems@computerhouse.com.au
                </address>
                <br />
                <h5>Items Issue Enquiry:</h5>
                <address>
                    orderitemsissue@computerhouse.com.au
                </address>
            </div>
        </div>
    </form>
</div>



@section Scripts{

    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");}

    <script src="https://polyfill.io/v3/polyfill.min.js?features=default"></script>
    @*<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDu45jwk_bHwMNjJGUpcTuzG1mZMUP47wA&callback=initMap&libraries=&v=weekly"
            defer></script>*@
    @*<script type="text/javascript" src="https://maps.googleapis.com/maps/api/js?sensor=false&callback=initMap"></script>*@


    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDu45jwk_bHwMNjJGUpcTuzG1mZMUP47wA&callback=initMap"
            async defer></script>

    <script type="text/javascript">

        let map;

        function initMap() {
            map = new google.maps.Map(document.getElementById('location'), {
                center: { lat: -33.963, lng: 151.099 },
                zoom: 14
            });
        }
    </script>
}