@model IEnumerable<ComputerHouse.Models.CartItem>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <!--first show with border, and remove if they do not like -->
    @*<div class="light-background-with-border">*@
    @if (Model!=null && Model.Count() !=0)
    {
        <br />
        @*<div class="card">*@
        <!--I do not want bordered card so, I replaced it with, div without card class-->
        <div>
            <div class="card-header">
                <div class="row">
                    <div class="col-12">
                        <h4 class="text-primary"><i class="fas fa-shopping-cart">&nbsp; Shopping Cart</i></h4>
                    </div>
                </div>
            </div>
            <div class="card-body">
                @{var subTotal = 0.0;}
                @foreach (var item in Model)
                {
                    <div class="row">
                        <div class="col-12 col-md-2">
                            @{
                                var base64 = Convert.ToBase64String(item.Device.Image);
                                var imgSrc = string.Format("data:image/jpg;base64,{0}", base64);
                            }
                            <img src="@imgSrc" class="img-fluid" />
                        </div>
                        <div class="col-12 col-md-10">
                            <div class="row m-1">
                                <h4 class="text-primary">@item.Device.Name</h4>
                            </div>
                            @*display-flex, align-items-center and Justify-content-center will put its child elements at the center of its parents*@
                            <!--https://www.freecodecamp.org/news/how-to-center-anything-with-css-align-a-div-text-and-more/-->
                            <div class="row d-flex align-items-center justify-content-center">
                                <!--d-none d-sm-block means do not display if the device is extra small-->
                                <div class="col-sm-4 d-none d-sm-block">
                                    <b>Hard Disk:</b>@item.Device.HDType<br />
                                    <b>HD Capacity:</b>@item.Device.HDCapacity<br />
                                    <b>RAM Capacity:</b>@item.Device.RAMCapacity<br />
                                    <b>Price:</b>@String.Format("{0:c}", item.Device.Price)
                                </div>
                                <div class="col-3 col-sm-2">
                                    @item.ItemCount Items
                                </div>
                                @*px-0 makes padding x-axis 0 which helps to align buttons horizontally in v.small device like iphone x or less than 375px*@
                                <div class="col-4 col-sm-3 px-0 text-center">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="IncreaseItem" asp-route-id="@item.Id"><i class="fas fa-plus"></i></a>
                                    <a class="btn btn-sm btn-outline-primary" asp-action="DecreaseItem" asp-route-id="@item.Id"><i class="fas fa-minus"></i></a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="RemoveItem" asp-route-id="@item.Id"><i class="fas fa-trash"></i></a>
                                </div>
                                <div class="col-5 col-sm-3">
                                    @{
                                        var itemTotal = 0.00;
                                        itemTotal = item.ItemCount * item.Device.Price;
                                        subTotal = subTotal + itemTotal;
                                    }

                                    @string.Format("{0:c}", itemTotal)
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr />
                }
                <div class="row">
                    <div class="col-12 text-right pr-5">
                        <b class="text-primary">Total Amount(AUD): @string.Format("{0:c}", subTotal)</b>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-6 col-md-3">
                        <a class="btn btn-outline-primary form-control" asp-area="Customer" asp-controller="Shoppings" asp-action="Index">Continue Shopping</a>
                    </div>
                    <div class="col-6 offset-md-6 col-md-3 text-right">
                        <a class="btn btn-secondary form-control" asp-action="Checkout">Check Out</a>
                    </div>
                </div>
            </div>
        </div>
        <!--implement similar features here-->
    }
    else
    {
        <div class="light-background-with-border">
            <p>No any items added to the shopping cart....</p>
            <a class="btn btn-lg btn-primary" asp-area="Customer" asp-controller="Shoppings" 
            asp-action="Index"><i class="fab fa-youtube"></i>&nbsp;&nbsp;Start Shopping</a>
        </div>
    }
    @*</div>*@
</div>

