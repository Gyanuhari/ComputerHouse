@model ComputerHouse.Models.ViewModels.ShoppingListBrandListVM
@{
    ViewData["Title"] = "Index";
}


<div class="container">
    @*First Show without using acrodonion
        <div class="row">
            <ul class="shopping-brand-filter-container">
                <li class="shopping-brand-filter-item"><a asp-action="Index"
                        asp-route-brandName="" class="btn btn-lg btn-outline-primary p-2">All</a></li>
                @foreach (var item in Model.BrandList)
                {
                    <li class="shopping-brand-filter-item"><a asp-action="Index" asp-route-brandName="@item.Name"
                        class="btn btn-outline-primary nav-link">@item.Name</a></li>
                }
            </ul>
        </div>*@

    @*If you have more than one selecting categories than you iterate here.*@
    <div class="row">
        <a class="btn accordion-brand"><h5 class="d-inline">Click To Select Brand</h5><span><i class="arrow down"></i></span></a>
        <div class="panel">
            <div class="row">
                <ul class="shopping-brand-filter-container">
                    <li class="shopping-brand-filter-item">
                        <a asp-action="Index"
                           asp-route-brandName="" class="btn btn-outline-primary nav-link">All</a>
                    </li>
                    @foreach (var item in Model.BrandList)
                    {
                        <li class="shopping-brand-filter-item">
                            <a asp-action="Index" asp-route-brandName="@item.Name"
                               class="btn btn-outline-primary nav-link">@item.Name</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    @if (Model.DeviceList != null && Model.DeviceList.Count() > 0)
    {
        @*<br />*@
        <div class="row">
            @foreach (var item in Model.DeviceList)
            {
                <div class="col-md-4 pt-0 new-product">
                    <div class="main-card">
                        @{
                            var base64 = Convert.ToBase64String(item.Image);
                            var imgSrc = string.Format("data:image/jpg;base64,{0}", base64);
                                         //This part is concating two string.
                        }
                        <img class="card-img-top p-2" src="@imgSrc" alt="Card image cap" style="height:250px; width:100%;" />
                        <div class="card-body text-center">
                            <h4 class="card-title"><strong>@item.Name</strong></h4>
                            <p class="card-text">
                                @{
                                    var desc = "";
                                    desc = string.Concat(item.Description.Substring(0, 110), "....");
                                }
                                @desc
                            </p>
                            <span class="rate-device">
                                @for (var i = 0; i < item.Rated; i++)
                                {
                                    <i class="fas fa-star"></i>
                                }
                                @for (var i = 0; i < (5 - item.Rated); i++)
                                {
                                    <i class="far fa-star"></i>
                                }
                            </span>
                            <br />
                            <br />
                            <h4>@string.Format("{0:c}", item.Price)</h4>
                            <br />
                            <ul>
                                <li><a asp-controller="Shoppings" asp-action="AddToWishList" asp-route-id="@item.Id"><i class="fas fa-heart"></i></a></li>
                                @*<li><a asp-controller="Shoppings" asp-action="Detail" asp-route-id="@item.Id"><i class="fas fa-search-plus"></i></a></li>*@
                                <li><a onclick='quickView("@item.Id")'><i class="fas fa-search-plus"></i></a></li>
                                <li><a asp-controller="Shoppings" asp-action="AddToCart" asp-route-id="@item.Id"><i class="fas fa-cart-plus"></i></a></li>
                            </ul>
                        </div>
                        @if (item.Quantity <= 5)
                        {
                            <div class="badge badge-light item-stock-info">Only @item.Quantity Remaining</div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row light-background-with-border">
            <p><h6 class="text-primary">There are no item.....</h6></p>
        </div>
    }
</div>

<!--Modal Popup For Quick View-->
<div class="modal fade bd-example-modal-lg" role="dialog" id="quick-view-modal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-body">
                @*Start*@
                <div class="light-background-with-border">
                    <div class="row">
                        <div class="col-12 col-md-5">
                            @*@{
                                    var base64 = Convert.ToBase64String(Model.Image);
                                    var imgSrc = string.Format("data:image/jpg;base64,{0}", base64);
                                }*@
                            <img id="img-device" src="" class="img-fluid" />
                        </div>
                        <div class="col-12 col-md-7">
                            <h3 id="modal-device-name"></h3>
                            <hr />
                            <h3 id="modal-device-price"></h3>
                            <hr />
                            <a href="#" id="features">See all features</a>
                            <br />
                            <hr />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <p id="modal-device-description"></p>
                            <hr />
                            <div class="row">
                                <div class="col-6 offset-6 text-right">
                                    <a class="btn btn-lg btn-light form-control" data-dismiss="modal"><b>CLOSE</b></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                @*End*@
            </div>
        </div>
    </div>
</div>
<!--End Of Modal Popup For Quick View-->

<script>
    //For Accordion Arrow
    var acc = document.getElementsByClassName("accordion-brand");
    var i;
    for (i = 0; i < acc.length; i++) {
        acc[i].addEventListener("click", function () {
            this.classList.toggle("active");
            $('.arrow').toggleClass('down up');
            var panel = this.nextElementSibling;
            if (panel.style.display === "block") {
                //panel.style.display = "none";
                $(".panel").slideUp("slow");
            } else {
                //panel.style.display = "block";
                $(".panel").slideDown("slow");
            }
        });
    }

