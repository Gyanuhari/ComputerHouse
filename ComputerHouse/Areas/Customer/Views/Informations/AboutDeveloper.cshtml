        <div class="row">
            <div class="col">
                <h4 class="text-primary">What To Learn Building This Responsive WebSite From Scratch?</h4>
                <hr />
            </div>
        </div>
        <div class="row">
            <div class="col-12 pb-2">
                @*<h2><b>Want To Learn To Build This Kind of Application Contact Me?</b></h2>*@
                <h4 class="text-primary"><b>Contact Tutor</b></h4>
            </div>
            <br />
        </div>
        <div class="row">
            <div class="col-lg-6">
                <div class="row">
                    @*In small device we want each inbox to be as a group so that there will be space between upper and lower input element*@
                    <div class="col-lg-6 form-group">
                        <input asp-for="FullName" class="form-control" placeholder="Your Name" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="col-lg-6 form-group">
                        <input asp-for="Email" class="form-control" placeholder="Your Email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 form-group">
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Mobile Number Eg. 0450956465" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="col-lg-6 form-group">
                        <input asp-for="Location" class="form-control" placeholder="Your Location" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-lg-12">
                        <textarea asp-for="Message" rows="6" class="form-control" placeholder="Your Message"></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-6">
                        <button type="submit" class="btn btn-lg btn-primary form-control">Submit Message</button>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 offset-lg-1 ml-lg-5 contact-address">
                <h4 class="text-primary">Contact Details</h4>
                <address>
                    Hari Tandan<br />
                    Software Developer<br />
                    Sydney, NSW 2220, Australia <br />
                    Phone: +61-0450956465 <br />
