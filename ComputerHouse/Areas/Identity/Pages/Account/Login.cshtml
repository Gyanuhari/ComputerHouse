@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="modal fade" role="dialog" tabindex="-1" id="login-modal">
    @*For tabindex:https://medium.com/@islam.sayed8/trap-focus-inside-a-modal-aa5230326c1b*@
    @*<div class="modal-dialog modal-dialog-centered">*@
        <div class="modal-dialog" style="top:15%;">
            <div class="modal-content">
                <div class="modal-body register-form">
                    <form id="account" method="post">
                        <div class="text-center">
                            <h4>Log In</h4>
                        </div>
                        <hr />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group">
                            @*<label asp-for="Input.Email"></label>*@
                            <input asp-for="Input.Email" class="form-control" placeholder="Email..." />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            @*<label asp-for="Input.Password"></label>*@
                            <input asp-for="Input.Password" class="form-control" placeholder="Password..." />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                            <p class="mt-1 float-right">
                                <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
                            </p>
                        </div>
                        <div class="form-group">
                            <div class="checkbox">
                                <label asp-for="Input.RememberMe" style="font-size:16px;">
                                    <input asp-for="Input.RememberMe"/>
                                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                                </label>
                            </div>
                        </div>
                        <div class="form-group">
                            <button type="submit" class="btn btn-lg btn-primary form-control">Log In</button>
                        </div>
                        <div class="form-group text-center">
                            <p>Are You A New User?</p>
                            <a class="btn btn-lg btn-primary form-control" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

