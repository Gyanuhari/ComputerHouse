@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h4 class="text-primary">@ViewData["Title"]</h4>
<hr />
<div class="row">
    <div class="col-md-10 col-lg-8">
        <p>Your account contains personal data that you have given us. This page allows you to download or delete that data.</p>
        <p>
            <strong class="text-warning">Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
        </p>
        <div class="row">
            <div class="col-6">
                <form id="download-data" asp-page="DownloadPersonalData" method="post" class="form-group">
                    <button class="btn btn-primary form-control" type="submit">Download</button>
                </form>
            </div>
            <div class="col-6">
                <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger form-control">Delete</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}