@using ComputerHouse.Extensions
@using ComputerHouse.Utility
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ComputerHouse</title>

    <environment include="Development">
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
              asp-fallback-href="~/lib/bootstrap/dist/css/bootstrap.min.css"
              asp-fallback-test-class="sr-only" asp-fallback-test-property="position" asp-fallback-test-value="absolute"
              crossorigin="anonymous"
              integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" />
    </environment>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.16/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    @*animate.style*@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.0.0/animate.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <!--top header-->
        <section class="header-top d-flex align-items-center">
            <div class="container">
                <!--making row display-flex with justify-content-between,so that we can adjust div-social-icons and div-login-cart-->
                <div class="row d-flex justify-content-between align-items-center">
                    <div class="div-social-icons">
                        <ul class="social-icons">
                            <li>
                                <a href="https://twitter.com/ComputerHouser" data-toggle="tooltip" title="Twitter"><i class="fab fa-twitter"></i></a>
                            </li>
                            <li>
                                <a href="" data-toggle="tooltip" title="Facebook"><i class="fab fa-facebook-square"></i></a>
                            </li>
                            <li>
                                <a href="https://www.linkedin.com/in/computer-house-39185b1b7/" data-toggle="tooltip" title="Linkedin"><i class="fab fa-linkedin"></i></a>
                            </li>
                            <li>
                                <a href="" data-toggle="tooltip" title="Google"><i class="fab fa-google-plus-g"></i></a>
                            </li>
                        </ul>
                    </div>
                    <div class="div-login-cart">
                        <ul class="login-cart text-right">
                            <li>
                                <a asp-area="Customer" asp-controller="WishLists" asp-action="Index" data-toggle="tooltip" title="My Wishlist"><span class="d-none d-md-inline">Wishlist&nbsp;</span><i class="fas fa-heart"></i></a>
                            </li>
                            <!--this position is for working with badge-->
                            <li class="position-relative">
                                @{
                                    var sessionItem = HttpContextAccessor.HttpContext.Session.GetObject<List<int>>(SD.SessionCart);
                                    if (sessionItem != null && sessionItem.Count() != 0)
                                    {
                                        <a asp-area="Customer" asp-controller="Carts" asp-action="Index" data-toggle="tooltip" title="My Shopping Cart">
                                            <span class="d-none d-md-inline">Cart&nbsp;</span><i class="fas fa-cart-plus"></i>
                                            <span class="badge badge-pill badge-info cart-count">@sessionItem.Count()</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="#" data-toggle="popover" id="js-shopping-cart"><span class="d-none d-md-inline">Cart&nbsp;</span><i class="fas fa-cart-plus"></i></a>
                                    }
                                }
                            </li>
                            <partial name="_LoginPartial" />
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!--main header-->
        <section class="header-main">
            @*<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">*@
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
                <div class="container">
                    <a class="navbar-brand" asp-area="Customer" asp-controller="Home" asp-action="Index"><img src="~/img/Logo20X20.png" class="img-fluid" style="max-height:60px; width:auto" /></a>
                    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse d-sm-inline-flex flex-row">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                @*<a class="nav-link text-dark" asp-area="Customer" asp-controller="Home" asp-action="Index">Home</a>*@
                                <a class="nav-link" asp-area="Customer" asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i>&nbsp;Home</a>
                            </li>
                            @if (User.IsInRole(SD.Admin))
                            {
                                @*Take this dropdown from bootswatch*@
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Admin</a>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Brands" asp-action="Index">Brand</a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="BrandCategories" asp-action="Index">Brand's Category</a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Devices" asp-action="Index">Device</a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Users" asp-action="Index">Users</a>
                                    </div>
                                </li>
                            }
                            @if (User.IsInRole(SD.Admin))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Support</a>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Supports" asp-action="Index">Manage Orders</a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Supports" asp-action="Index">Order History</a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Supports" asp-action="Index">Email Services</a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Supports" asp-action="Index">Reporting</a>
                                    </div>
                                </li>
                            }
                            <li class="nav-item">
                                @*<a class="nav-link text-dark" asp-area="Customer" asp-controller="Home" asp-action="Privacy">Privacy</a>*@
                                <a class="nav-link" asp-area="Customer" asp-controller="Shoppings" asp-action="Index">Start Shopping</a>
                            </li>
                            @if (User.IsInRole(SD.Customer))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">My Order</a>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item" asp-area="Customer" asp-controller="Orders" asp-action="Index">Track Recent Orders</a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" asp-area="Customer" asp-controller="Orders" asp-action="MyOrderHistory">My Orders History</a>
                                    </div>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link" href="/Customer/Home/Index/#about-us">About Us</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Customer" asp-controller="Home" asp-action="Contact">Contact</a>
                            </li>
                        </ul>
                        @*d-none d-lg-block, do not display except devices larger than lg:992px*@
                        @*<div class="flex-grow-1 d-none d-lg-block">
                                <form>
                                    <div class="input-group">
                                        <input type="text" class="form-control" name="searchName" placeholder="Search By Brand: Apple Samsung Dell ...">
                                        <div class="input-group-append">
                                            <button type="submit" class="btn border" id="searchId" asp-route-brandName="Apple" asp-action="Index" asp-controller="Shoppings" asp-area="Customer"><i class="fas fa-search"></i></button>
                                        </div>
                                    </div>
                                </form>
                            </div>*@
                    </div>
                </div>
            </nav>
        </section>
    </header>
    <!--body-->
    <section class="body-container">
        <partial name="_CookieConsentPartial" />
        @RenderBody()
    </section>

    <!--<section class="body-container">-->
        <!--Instagram feeds-->
        <!--<div id="instafeed"></div>
    </section>-->

    <!--footer-->
    <a id="back-to-top" href="#" class="btn btn-back-to-top" role="button">
        <i class="fas fa-chevron-up"></i>
    </a>
    <section class="footer-main">
        <div class="container">
            <div class="row">
                <div class="col text-center">
                    <h5>MY ACCOUNT</h5>
                    <ul>
                        <li>
                            <a asp-area="Identity" asp-page="/Account/Login">Sign In</a>
                        </li>
                        <li>
                            <a asp-area="Identity" asp-page="/Account/Register">Sign Up</a>
                        </li>
                        <li>
                            <a asp-area="Identity" asp-page="/Account/Manage/Index">My Profile</a>
                        </li>
                        <li>
                            <a asp-area="Customer" asp-controller="Orders" asp-action="MyOrderHistory">Order History</a>
                        </li>
                    </ul>
                </div>
                <div class="col text-center">
                    <h5>INFORMATION</h5>
                    <ul>
                        <li>
                            <a asp-area="Customer" asp-controller="Home" asp-action="Privacy">Privacy</a>
                            @*<a href="">Privacy Policy</a>*@
                        </li>
                        <li>
                            <a href="/Customer/Home/Index/#about-us">About Us</a>
                        </li>
                        <li>
                            <a href="/Customer/Home/Contact">Contact Us</a>
                        </li>
                        <li>
                            <a href="">Terms And Conditions</a>
                        </li>
                    </ul>
                </div>
                <div class="col text-center">
                    <h5>EXTRAS</h5>
                    <ul>
                        <li>
                            <a asp-area="Customer" asp-controller="Informations" asp-action="SiteDescriptions">Site Descriptions</a>
                        </li>
                        <li>
                            <a href="">Anything</a>
                        </li>
                        <li>
                            <a href="">May Be Anything</a>
                        </li>
                        <li>
                            <a href="">Could Be Anything</a>
                        </li>
                    </ul>
                </div>
            </div>
            <hr />
            <div class="row">
                <div>
                    &copy; @DateTime.Now.ToString("yyyy") - ComputerHouse - Developer: <a asp-area="Admin" asp-controller="Home"
                                                                                          asp-action="Developer">Hari Tandan</a>
                </div>
            </div>
        </div>
    </section>

    @*<div class="container">
            <partial name="_CookieConsentPartial" />
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>*@

    @*<footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2020 - ComputerHouse - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>*@

    <environment include="Development">
        <script src="~/lib/jquery/dist/jquery.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"
                asp-fallback-src="~/lib/jquery/dist/jquery.min.js"
                asp-fallback-test="window.jQuery"
                crossorigin="anonymous"
                integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8=">
        </script>
        <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.bundle.min.js"
                asp-fallback-src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"
                asp-fallback-test="window.jQuery && window.jQuery.fn && window.jQuery.fn.modal"
                crossorigin="anonymous"
                integrity="sha384-xrRywqdh3PHs8keKZN+8zzc5TX0GRTLCcmivcbNJWm2rs5C8PRhcEn3czEjhAO9o">
        </script>
    </environment>


    <script src="~/js/site.js" type="text/javascript" asp-append-version="true"></script>
    <script type="text/javascript" src="~/lib/instafeed.js/dist/instafeed.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.16/js/jquery.dataTables.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
    <script src="https://kit.fontawesome.com/e19c476714.js"></script>
    @*Jquery Added later as Jquery is used above should not be used twice, it causes problem.*@
    @*<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.1.0/jquery.min.js"></script>*@
    <script type="text/javascript" src="https://cdn.datatables.net/1.10.16/js/jquery.dataTables.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
